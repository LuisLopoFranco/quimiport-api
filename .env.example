# Ambiente: development | production | test
NODE_ENV=development
# Porta HTTP da API
PORT=3000
# Conexão com o PostgreSQL. Use "memory" para rodar sem banco (dados em memória).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quimiport
# Nível de log do pino: trace | debug | info | warn | error
LOG_LEVEL=info
# Usado apenas pelos testes de integração com banco real (descomente para rodá-los)
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/quimiport_test